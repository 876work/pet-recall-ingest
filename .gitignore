# Dependencies
node_modules/

# Wrangler build cache and local state. state/v3/d1 holds a local copy of the
# D1 database, which includes the devices table and its push tokens — this
# directory must never be committed.
.wrangler/

# Local secret overrides for `wrangler dev`. Real values live in
# `wrangler secret put`, never in the repo.
.dev.vars
.dev.vars.*
.env
.env.*

# Credentials and signing material. No .p8 is used by this Worker today, but an
# APNs key is the kind of file that arrives later and gets committed by accident.
*.p8
*.pem
*.key
*.cer
*.p12
*.mobileprovision

# Generated by drain.sh on every run — program output, not source.
drain-final-stats.json

# Editor and OS noise
.DS_Store
.idea/
.vscode/
*.log
